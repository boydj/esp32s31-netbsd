# ESP32-S31 radio co-processor firmware (hart 1).
CONFIG_IDF_TARGET="esp32s31"

# Single-core build; espcp_sys runs it on hart 1.
CONFIG_ESPCP_FIRMWARE=y
CONFIG_FREERTOS_UNICORE=y
CONFIG_FREERTOS_HZ=100
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# The host owns the console, the watchdogs, power and the flash.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_INT_WDT is not set
# CONFIG_ESP_TASK_WDT_EN is not set
# CONFIG_ESP_BROWNOUT_DET is not set
# CONFIG_ESP_SYSTEM_HW_STACK_GUARD is not set
# CONFIG_ESP_SYSTEM_MEMPROT is not set
# CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP is not set
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y
# CONFIG_ESP_DEBUG_OCDAWARE is not set
# CONFIG_PM_ENABLE is not set
# CONFIG_SPIRAM is not set
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Wi-Fi: no NVS, no calibration data in flash; keep IRAM for data.
CONFIG_ESP_WIFI_NVS_ENABLED=n
# CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE is not set
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set

# Bluetooth: dual-mode controller only, behind the VHCI.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=y

# Leave the GPIO matrix to the host: no light-sleep pin isolation.
# CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND is not set

# The AES, SHA and RSA accelerators belong to NetBSD's espcrypto(4), and
# the ECC engine to the Bluetooth controller: mbedTLS (the WPA2/WPA3
# handshakes) does without all of them.
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# CONFIG_MBEDTLS_HARDWARE_GCM is not set
# CONFIG_MBEDTLS_HARDWARE_SHA is not set
# CONFIG_MBEDTLS_HARDWARE_MPI is not set
# CONFIG_MBEDTLS_HARDWARE_ECC is not set
# CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY is not set
# CONFIG_MBEDTLS_HARDWARE_ECDSA_SIGN is not set
