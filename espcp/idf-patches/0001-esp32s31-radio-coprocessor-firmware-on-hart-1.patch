diff --git a/components/freertos/port_systick.c b/components/freertos/port_systick.c
index 505d41da..b3d0a3de 100644
--- a/components/freertos/port_systick.c
+++ b/components/freertos/port_systick.c
@@ -60,6 +60,42 @@ static systimer_hal_context_t systimer_hal;
  * It is done at the same time so SysTicks for both CPUs occur at the same time or very close.
  * Shifts a time of triggering interrupts for core 0 and core 1.
  */
+#if CONFIG_ESPCP_FIRMWARE
+/*
+ * Co-processor firmware on hart 1: the OS on hart 0 already runs the
+ * systimer (counter 0 and alarm 0).  Don't reset or reconfigure it; tick
+ * from alarm 1 on counter 1.
+ */
+#define ESPCP_TICK_ALARM    (SYSTIMER_ALARM_OS_TICK_CORE0 + 1)
+#define SYSTICK_ALARM(cpuid)    ESPCP_TICK_ALARM
+
+void vSystimerSetup(void)
+{
+#ifdef CONFIG_FREERTOS_CORETIMER_SYSTIMER_LVL3
+    const unsigned level = ESP_INTR_FLAG_LEVEL3;
+#else
+    const unsigned level = ESP_INTR_FLAG_LEVEL1;
+#endif
+
+    ESP_ERROR_CHECK(esp_intr_alloc(ETS_SYSTIMER_TARGET0_INTR_SOURCE + 1, ESP_INTR_FLAG_IRAM | level, SysTickIsrHandler, &systimer_hal, NULL));
+
+    systimer_hal_init(&systimer_hal);
+    systimer_hal_tick_rate_ops_t ops = {
+        .ticks_to_us = systimer_ticks_to_us,
+        .us_to_ticks = systimer_us_to_ticks,
+    };
+    systimer_hal_set_tick_rate_ops(&systimer_hal, &ops);
+    systimer_ll_set_counter_value(systimer_hal.dev, SYSTIMER_COUNTER_OS_TICK, 0);
+    systimer_ll_apply_counter_value(systimer_hal.dev, SYSTIMER_COUNTER_OS_TICK);
+    systimer_hal_connect_alarm_counter(&systimer_hal, ESPCP_TICK_ALARM, SYSTIMER_COUNTER_OS_TICK);
+    systimer_hal_set_alarm_period(&systimer_hal, ESPCP_TICK_ALARM, 1000000UL / CONFIG_FREERTOS_HZ);
+    systimer_hal_select_alarm_mode(&systimer_hal, ESPCP_TICK_ALARM, SYSTIMER_ALARM_MODE_PERIOD);
+    systimer_hal_enable_alarm_int(&systimer_hal, ESPCP_TICK_ALARM);
+    systimer_hal_enable_counter(&systimer_hal, SYSTIMER_COUNTER_OS_TICK);
+}
+#else /* !CONFIG_ESPCP_FIRMWARE */
+#define SYSTICK_ALARM(cpuid)    (SYSTIMER_ALARM_OS_TICK_CORE0 + (cpuid))
+
