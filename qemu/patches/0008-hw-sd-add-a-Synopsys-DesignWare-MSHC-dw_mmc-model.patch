+
+#ifndef HW_SD_DW_MSHC_H
+#define HW_SD_DW_MSHC_H
+
+#include "hw/core/sysbus.h"
+#include "hw/sd/sd.h"
+#include "qom/object.h"
+
+#define TYPE_DW_MSHC "dw-mshc"
+OBJECT_DECLARE_SIMPLE_TYPE(DWMSHCState, DW_MSHC)
+
+#define TYPE_DW_MSHC_BUS "dw-mshc-bus"
+
+#define DW_MSHC_REG_SIZE    0x1000
+
+struct DWMSHCState {
+    SysBusDevice parent_obj;
+
+    SDBus sdbus;
+    MemoryRegion iomem;
+    MemoryRegion *dma_mr;
+    AddressSpace dma_as;
+    qemu_irq irq;
+
+    /* properties */
+    uint32_t fifo_depth;
+    uint32_t verid;
+
+    uint32_t ctrl;
+    uint32_t pwren;
+    uint32_t clkdiv;
+    uint32_t clksrc;
+    uint32_t clkena;
+    uint32_t tmout;
+    uint32_t ctype;
+    uint32_t blksiz;
+    uint32_t bytcnt;
+    uint32_t intmask;
+    uint32_t cmdarg;
+    uint32_t cmd;
+    uint32_t resp[4];
+    uint32_t rintsts;
+    uint32_t fifoth;
+    uint32_t tcbcnt;
+    uint32_t debnce;
+    uint32_t usrid;
+    uint32_t uhs;
+    uint32_t rst_n;
+    uint32_t bmod;
+    uint32_t dbaddr;
+    uint32_t idsts;
+    uint32_t idinten;
+    uint32_t dscaddr;
+    uint32_t bufaddr;
+    uint32_t cardthrctl;
+    uint32_t backend_power;
+    uint32_t vendor[0x400 / 4];     /* 0x800-0xbff: vendor glue registers */
+};
+
+#endif /* HW_SD_DW_MSHC_H */
