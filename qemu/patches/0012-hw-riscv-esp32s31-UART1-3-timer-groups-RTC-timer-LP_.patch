+/* ------------------------------------------------------- timer groups */
+
+/*
+ * Only what NetBSD uses: the main system watchdog (one stage, "reset
+ * system"), and in group 0 the RTC slow clock calibration, which finds
+ * the 136 kHz RC oscillator exactly where it should be.
+ */
+#define TIMG_WDTCONFIG0     0x48
+#define  WDT_EN                 (1u << 31)
+#define  WDT_CONF_UPDATE        (1u << 22)
+#define TIMG_WDTCONFIG1     0x4c
+#define TIMG_WDTCONFIG2     0x50
+#define TIMG_WDTFEED        0x60
+#define TIMG_WDTWPROTECT    0x64
+#define  WDT_WKEY               0x50d83aa1
+#define TIMG_RTCCALICFG     0x68
+#define  CALI_RDY               (1u << 15)
+#define  CALI_START             (1u << 31)
+#define TIMG_RTCCALICFG1    0x6c
+#define TIMG_RTCCALICFG2    0x80
+
+#define S31_RC_SLOW_HZ      136000
+
+typedef struct S31Timg S31Timg;
+
+static void timg_wdt_arm(S31Timg *t)
+{
+    uint32_t c0 = t->regs[TIMG_WDTCONFIG0 / 4];
+    uint64_t prescale = t->regs[TIMG_WDTCONFIG1 / 4] >> 16;
+    uint64_t ticks = t->regs[TIMG_WDTCONFIG2 / 4];
+
+    if (!(c0 & WDT_EN) || ((c0 >> 29) & 3) != 3) {
+        timer_del(t->wdt);
+        return;
+    }
+    if (prescale == 0) {
+        prescale = 1;
+    }
+    timer_mod(t->wdt, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              muldiv64(ticks * prescale, NANOSECONDS_PER_SECOND, 40000000));
+}
+
+static void timg_wdt_expired(void *opaque)
+{
+    qemu_log_mask(LOG_GUEST_ERROR, "esp32s31: watchdog reset\n");
+    qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+}
+
+static uint64_t timg_read(void *opaque, hwaddr addr, unsigned size)
+{
+    S31Timg *t = opaque;
+
+    return addr < sizeof(t->regs) ? t->regs[addr / 4] : 0;
+}
+
+static void timg_write(void *opaque, hwaddr addr, uint64_t val,
+                       unsigned size)
+{
+    S31Timg *t = opaque;
+    const bool unlocked = t->regs[TIMG_WDTWPROTECT / 4] == WDT_WKEY;
+
+    if (addr >= sizeof(t->regs)) {
+        return;
+    }
+    switch (addr) {
+    case TIMG_WDTWPROTECT:
+        t->regs[addr / 4] = val;
+        break;
+    case TIMG_WDTCONFIG0:
+    case TIMG_WDTCONFIG1:
+    case TIMG_WDTCONFIG2:
+        if (unlocked) {
+            t->regs[addr / 4] = val & ~WDT_CONF_UPDATE;
+            timg_wdt_arm(t);
+        }
+        break;
+    case TIMG_WDTFEED:
+        if (unlocked) {
+            timg_wdt_arm(t);
+        }
+        break;
+    case TIMG_RTCCALICFG:
+        t->regs[addr / 4] = val & ~CALI_RDY;
+        if (val & CALI_START) {
+            uint64_t n = (val >> 16) & 0x7fff;
+
+            t->regs[TIMG_RTCCALICFG1 / 4] =
+                (uint32_t)(n * 40000000 / S31_RC_SLOW_HZ) << 7;
+            t->regs[addr / 4] |= CALI_RDY;
+        }
+        break;
+    default:
+        t->regs[addr / 4] = val;
+        break;
+    }
+}
+
+static const MemoryRegionOps timg_ops = {
+    .read = timg_read,
+    .write = timg_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+/* ------------------------------------------- IO_MUX, LP_SYS, RTC timer */
+
+static uint64_t iomux_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Esp32s31State *s = opaque;
+
+    return s->iomux_regs[addr / 4];
+}
+
+static void iomux_write(void *opaque, hwaddr addr, uint64_t val,
+                        unsigned size)
+{
+    Esp32s31State *s = opaque;
+
+    s->iomux_regs[addr / 4] = val;
+}
+
+static const MemoryRegionOps iomux_ops = {
+    .read = iomux_read,
+    .write = iomux_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static uint64_t lpsys_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Esp32s31State *s = opaque;
+
+    return s->lpsys_regs[addr / 4];
+}
+
+static void lpsys_write(void *opaque, hwaddr addr, uint64_t val,
+                        unsigned size)
+{
+    Esp32s31State *s = opaque;
+
+    s->lpsys_regs[addr / 4] = val;
+}
+
+static const MemoryRegionOps lpsys_ops = {
+    .read = lpsys_read,
+    .write = lpsys_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+/* The RTC timer counts the 136 kHz slow clock from power-up. */
+#define RTC_UPDATE          0x10
+#define  RTC_MAIN_TIMER_UPDATE  (1u << 27)
+#define RTC_MAIN_BUF0_LOW   0x14
+#define RTC_MAIN_BUF0_HIGH  0x18
+
+static uint64_t rtctimer_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Esp32s31State *s = opaque;
+
+    return addr < sizeof(s->rtc_regs) ? s->rtc_regs[addr / 4] : 0;
+}
+
+static void rtctimer_write(void *opaque, hwaddr addr, uint64_t val,
+                           unsigned size)
+{
+    Esp32s31State *s = opaque;
+
+    if (addr >= sizeof(s->rtc_regs)) {
+        return;
+    }
+    if (addr == RTC_UPDATE && (val & RTC_MAIN_TIMER_UPDATE)) {
+        uint64_t ticks = muldiv64(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+                                  S31_RC_SLOW_HZ, NANOSECONDS_PER_SECOND);
+
+        s->rtc_regs[RTC_MAIN_BUF0_LOW / 4] = ticks;
+        s->rtc_regs[RTC_MAIN_BUF0_HIGH / 4] = (ticks >> 32) & 0xffff;
+        val &= ~RTC_MAIN_TIMER_UPDATE;
+    }
+    s->rtc_regs[addr / 4] = val;
+}
+
+static const MemoryRegionOps rtctimer_ops = {
+    .read = rtctimer_read,
+    .write = rtctimer_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
