diff --git a/include/hw/misc/esp32s31_coproc.h b/include/hw/misc/esp32s31_coproc.h
new file mode 100644
index 0000000..18fdfae
--- /dev/null
+++ b/include/hw/misc/esp32s31_coproc.h
@@ -0,0 +1,59 @@
+/*
+ * ESP32-S31 radio co-processor stand-in (see hw/misc/esp32s31_coproc.c).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_MISC_ESP32S31_COPROC_H
+#define HW_MISC_ESP32S31_COPROC_H
+
+#include "hw/core/sysbus.h"
+#include "chardev/char-fe.h"
+#include "net/net.h"
+#include "qom/object.h"
+
+#define TYPE_ESP32S31_COPROC "esp32s31-coproc"
+OBJECT_DECLARE_SIMPLE_TYPE(Esp32s31CoprocState, ESP32S31_COPROC)
+
+struct Esp32s31CoprocState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion fromcpu_mr;
+    MemoryRegion hpcore1_mr;
+    qemu_irq irq;
+    QEMUBH *bh;
+    QEMUTimer *boot_timer;
+    QEMUTimer *assoc_timer;
+    QEMUTimer *beat_timer;
+
+    /* properties */
+    NICConf conf;
+    CharFrontend chr;
+    char *ssid;
+    char *password;
+    uint64_t fw_base;
+
+    NICState *nic;
+    uint32_t from_cpu[4];
+    uint32_t hpcore1_ctrl;
+
+    bool running;
+    hwaddr shm;
+    uint32_t shmsize;
+    uint32_t heartbeat;
+
+    uint8_t wifi_state;
+    uint8_t wifi_reason;
+    char cur_ssid[33];
+    char cur_pass[65];
+
+    bool bt_enabled;
+    uint8_t h4[1 + 4 + 1024];
+    size_t h4_len;
+    size_t h4_want;
+    bool h4_hdr_done;
+
+    uint8_t msg[2048];
+};
+
+#endif /* HW_MISC_ESP32S31_COPROC_H */
