+/*
+ * Espressif ESP32-S31 vendor CSRs.
+ *
+ * The chip has a PMA (physical memory attribute) unit configured through
+ * 16 pmacfg (0xbc0-0xbcf) and 16 pmaaddr (0xbd0-0xbdf) M-mode CSRs.  QEMU
+ * doesn't model PMAs; just provide storage so firmware runs.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "target/riscv/tcg/csr.h"
+
+#define CSR_ESP_PMACFG0     0xbc0
+#define CSR_ESP_PMAADDR0    0xbd0
+#define ESP_NPMA            16
+
+static target_ulong esp_pma_regs[2 * ESP_NPMA];
+
+static RISCVException esp_mmode(CPURISCVState *env, int csrno)
+{
+    return RISCV_EXCP_NONE;
+}
+
+static bool test_esp_mvendorid(RISCVCPU *cpu)
+{
+    return cpu->cfg.mvendorid == 0x612;
+}
+
+static RISCVException read_esp_pma(CPURISCVState *env, int csrno,
+                                   target_ulong *val)
+{
+    *val = esp_pma_regs[csrno - CSR_ESP_PMACFG0];
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException write_esp_pma(CPURISCVState *env, int csrno,
+                                    target_ulong val, uintptr_t ra)
+{
+    esp_pma_regs[csrno - CSR_ESP_PMACFG0] = val;
+    return RISCV_EXCP_NONE;
+}
+
+#define ESP_PMA_CSR(n, name) \
+    { \
+        .csrno = (n), \
+        .insertion_test = test_esp_mvendorid, \
+        .csr_ops = { name, esp_mmode, read_esp_pma, write_esp_pma } \
+    }
+
+const RISCVCSR esp_csr_list[] = {
+    ESP_PMA_CSR(0xbc0, "esp.pmacfg0"),  ESP_PMA_CSR(0xbc1, "esp.pmacfg1"),
+    ESP_PMA_CSR(0xbc2, "esp.pmacfg2"),  ESP_PMA_CSR(0xbc3, "esp.pmacfg3"),
+    ESP_PMA_CSR(0xbc4, "esp.pmacfg4"),  ESP_PMA_CSR(0xbc5, "esp.pmacfg5"),
+    ESP_PMA_CSR(0xbc6, "esp.pmacfg6"),  ESP_PMA_CSR(0xbc7, "esp.pmacfg7"),
+    ESP_PMA_CSR(0xbc8, "esp.pmacfg8"),  ESP_PMA_CSR(0xbc9, "esp.pmacfg9"),
+    ESP_PMA_CSR(0xbca, "esp.pmacfg10"), ESP_PMA_CSR(0xbcb, "esp.pmacfg11"),
+    ESP_PMA_CSR(0xbcc, "esp.pmacfg12"), ESP_PMA_CSR(0xbcd, "esp.pmacfg13"),
+    ESP_PMA_CSR(0xbce, "esp.pmacfg14"), ESP_PMA_CSR(0xbcf, "esp.pmacfg15"),
+    ESP_PMA_CSR(0xbd0, "esp.pmaaddr0"),  ESP_PMA_CSR(0xbd1, "esp.pmaaddr1"),
+    ESP_PMA_CSR(0xbd2, "esp.pmaaddr2"),  ESP_PMA_CSR(0xbd3, "esp.pmaaddr3"),
+    ESP_PMA_CSR(0xbd4, "esp.pmaaddr4"),  ESP_PMA_CSR(0xbd5, "esp.pmaaddr5"),
+    ESP_PMA_CSR(0xbd6, "esp.pmaaddr6"),  ESP_PMA_CSR(0xbd7, "esp.pmaaddr7"),
+    ESP_PMA_CSR(0xbd8, "esp.pmaaddr8"),  ESP_PMA_CSR(0xbd9, "esp.pmaaddr9"),
+    ESP_PMA_CSR(0xbda, "esp.pmaaddr10"), ESP_PMA_CSR(0xbdb, "esp.pmaaddr11"),
+    ESP_PMA_CSR(0xbdc, "esp.pmaaddr12"), ESP_PMA_CSR(0xbdd, "esp.pmaaddr13"),
+    ESP_PMA_CSR(0xbde, "esp.pmaaddr14"), ESP_PMA_CSR(0xbdf, "esp.pmaaddr15"),
