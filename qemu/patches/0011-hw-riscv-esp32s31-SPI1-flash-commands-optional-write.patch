 {
     Esp32s31State *s = ESP32S31_MACHINE(obj);
@@ -1358,6 +1577,12 @@ static void esp32s31_machine_class_init(ObjectClass *oc, const void *data)
                               esp32s31_set_xip_offset, NULL, NULL);
     object_class_property_set_description(oc, "xip-offset",
         "Raw flash offset the SPL maps at 0x40000000 (default 0x100000)");
