+/* ------------------------------------------------------- SPI1 (flash) */
+
+/*
+ * The MSPI controller's software port to the flash: user-defined
+ * commands (reads, status, ID) and the built-in write enable, sector or
+ * block erase and page program.  Commands complete at once.  Writes go to
+ * the whole-chip image, to the XIP window's copy of it, and with
+ * flash-writeback=on to the image file.
+ */
+#define SPI1_CMD                0x00
+#define  SPI1_CMD_USR           (1u << 18)
+#define  SPI1_CMD_FLASH_BE      (1u << 23)
+#define  SPI1_CMD_FLASH_SE      (1u << 24)
+#define  SPI1_CMD_FLASH_PP      (1u << 25)
+#define  SPI1_CMD_FLASH_RDSR    (1u << 27)
+#define  SPI1_CMD_FLASH_WRDI    (1u << 29)
+#define  SPI1_CMD_FLASH_WREN    (1u << 30)
+#define SPI1_ADDR               0x04
+#define SPI1_USER               0x18
+#define  SPI1_USER_USR_MOSI     (1u << 27)
+#define  SPI1_USER_USR_MISO     (1u << 28)
+#define SPI1_USER2              0x20
+#define SPI1_MOSI_DLEN          0x24
+#define SPI1_MISO_DLEN          0x28
+#define SPI1_RD_STATUS          0x2c
+#define SPI1_W0                 0x58
+#define SPI1_NW                 16
+#define SPI1_DATE               0x3fc
+
+#define S31_FLASH_ID            0x1840c8    /* GigaDevice GD25Q128 */
+
+static void spi1_flash_changed(Esp32s31State *s, uint32_t off, uint32_t len)
+{
+    uint8_t *xip = memory_region_get_ram_ptr(&s->flash);
+
+    if (off + len > s->xip_offset) {
+        uint32_t from = MAX(off, s->xip_offset);
+        uint32_t to = MIN(off + len,
+                          s->xip_offset + (uint32_t)S31_FLASH_SIZE);
+
+        if (to > from) {
+            memcpy(xip + (from - s->xip_offset), s->flash_chip + from,
+                   to - from);
+        }
+    }
+    if (s->flash_fd >= 0 &&
+        pwrite(s->flash_fd, s->flash_chip + off, len, off) != len) {
+        warn_report("esp32s31: can't write back flash at 0x%x", off);
+    }
+}
+
+static void spi1_erase(Esp32s31State *s, uint32_t addr, uint32_t size)
+{
+    if (!s->flash_wel) {
+        return;
+    }
+    addr &= (S31_FLASH_CHIP_SIZE - 1) & ~(size - 1);
+    memset(s->flash_chip + addr, 0xff, size);
+    spi1_flash_changed(s, addr, size);
+    s->flash_wel = false;
+}
+
+static void spi1_program(Esp32s31State *s, uint32_t addr, uint32_t len)
+{
+    const uint8_t *buf = (const uint8_t *)&s->spi1_regs[SPI1_W0 / 4];
+    uint32_t page = addr & (S31_FLASH_CHIP_SIZE - 1) & ~0xffu;
+
+    if (!s->flash_wel) {
+        return;
+    }
+    len = MIN(len, SPI1_NW * 4u);
+    for (uint32_t i = 0; i < len; i++) {
+        /* NOR: bits only go from 1 to 0; wraps within the page */
+        s->flash_chip[page + ((addr + i) & 0xff)] &= buf[i];
+    }
+    spi1_flash_changed(s, page, 256);
+    s->flash_wel = false;
+}
+
+static uint8_t spi1_status(Esp32s31State *s)
+{
+    return s->flash_wel ? 0x02 : 0x00;
+}
+
+static void spi1_user(Esp32s31State *s)
+{
+    uint32_t *r = s->spi1_regs;
+    uint8_t *w = (uint8_t *)&r[SPI1_W0 / 4];
+    uint32_t user = r[SPI1_USER / 4];
+    uint8_t cmd = r[SPI1_USER2 / 4] & 0xff;
+    uint32_t addr = r[SPI1_ADDR / 4] & (S31_FLASH_CHIP_SIZE - 1);
+    uint32_t inlen = (user & SPI1_USER_USR_MISO) ?
+                     MIN((r[SPI1_MISO_DLEN / 4] & 0x3ff) / 8 + 1,
+                         SPI1_NW * 4u) : 0;
+    uint32_t outlen = (user & SPI1_USER_USR_MOSI) ?
+                      MIN((r[SPI1_MOSI_DLEN / 4] & 0x3ff) / 8 + 1,
+                          SPI1_NW * 4u) : 0;
+    uint32_t id = cpu_to_le32(S31_FLASH_ID);
+
+    switch (cmd) {
+    case 0x03: case 0x0b: case 0x3b: case 0x6b: case 0xbb: case 0xeb:
+        for (uint32_t i = 0; i < inlen; i++) {
+            w[i] = s->flash_chip[(addr + i) & (S31_FLASH_CHIP_SIZE - 1)];
+        }
+        break;
+    case 0x9f:
+        memcpy(w, &id, MIN(inlen, 3u));
+        break;
+    case 0x05:
+        w[0] = spi1_status(s);
+        break;
+    case 0x35:
+    case 0x15:
+        w[0] = 0;
+        break;
+    case 0x06:
+        s->flash_wel = true;
+        break;
+    case 0x04:
+        s->flash_wel = false;
+        break;
+    case 0x20:
+        spi1_erase(s, addr, 4 * KiB);
+        break;
+    case 0xd8:
+        spi1_erase(s, addr, 64 * KiB);
+        break;
+    case 0x02:
+        spi1_program(s, addr, outlen);
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "esp32s31: SPI1 command 0x%02x\n", cmd);
+        break;
+    }
+}
+
+static uint64_t spi1_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Esp32s31State *s = opaque;
+
+    if (addr == SPI1_CMD) {
+        return 0;               /* always done */
+    }
+    return s->spi1_regs[addr / 4];
+}
+
+static void spi1_write(void *opaque, hwaddr addr, uint64_t val,
+                       unsigned size)
+{
+    Esp32s31State *s = opaque;
+    uint32_t a;
+
+    if (addr != SPI1_CMD) {
+        if (addr != SPI1_DATE) {
+            s->spi1_regs[addr / 4] = val;
+        }
+        return;
+    }
+    a = s->spi1_regs[SPI1_ADDR / 4];
+    if (val & SPI1_CMD_FLASH_WREN) {
+        s->flash_wel = true;
+    }
+    if (val & SPI1_CMD_FLASH_WRDI) {
+        s->flash_wel = false;
+    }
+    if (val & SPI1_CMD_FLASH_SE) {
+        spi1_erase(s, a, 4 * KiB);
+    }
+    if (val & SPI1_CMD_FLASH_BE) {
+        spi1_erase(s, a, 64 * KiB);
+    }
+    if (val & SPI1_CMD_FLASH_PP) {
+        spi1_program(s, a & 0xffffff, a >> 24);
+    }
+    if (val & SPI1_CMD_FLASH_RDSR) {
+        s->spi1_regs[SPI1_RD_STATUS / 4] = spi1_status(s);
+    }
+    if (val & SPI1_CMD_USR) {
+        spi1_user(s);
+    }
+}
+
+static const MemoryRegionOps spi1_ops = {
+    .read = spi1_read,
+    .write = spi1_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
 /* ------------------------------------------------------------- the board */
 
