                            &error_fatal);
     uint8_t *flash = memory_region_get_ram_ptr(&s->flash);
     memset(flash, 0xff, S31_FLASH_SIZE);
+    s->flash_chip = g_malloc(S31_FLASH_CHIP_SIZE);
+    memset(s->flash_chip, 0xff, S31_FLASH_CHIP_SIZE);
+    s->flash_fd = -1;
     memory_region_add_subregion(sysmem, S31_FLASH_BASE, &s->flash);
 
     /* Peripherals */
@@ -1145,6 +1346,9 @@ static void esp32s31_machine_init(MachineState *machine)
     memory_region_init_io(&s->trng_mr, NULL, &trng_ops, s,
                           "esp32s31.trng", S31_TRNG_SIZE);
     memory_region_add_subregion(sysmem, S31_TRNG_BASE, &s->trng_mr);
+    memory_region_init_io(&s->spi1_mr, NULL, &spi1_ops, s,
+                          "esp32s31.spi1", S31_SPI1_SIZE);
+    memory_region_add_subregion(sysmem, S31_SPI1_BASE, &s->spi1_mr);
 
     /*
      * Ethernet: the EMAC is a DesignWare GMAC 3.70a, close enough to the
@@ -1262,6 +1466,11 @@ static void esp32s31_machine_init(MachineState *machine)
                            (size_t)S31_FLASH_SIZE);
             memcpy(flash, img + s->xip_offset, n);
         }
+        memcpy(s->flash_chip, img, MIN((size_t)size,
+                                       (size_t)S31_FLASH_CHIP_SIZE));
+        if (s->flash_writeback) {
+            s->flash_fd = qemu_open(s->flash_file, O_RDWR, &error_fatal);
+        }
         if (!machine->firmware) {
             esp32s31_spl_boot(s, flash, S31_FLASH_SIZE);
             return;
@@ -1327,6 +1536,16 @@ static void esp32s31_set_asid(Object *obj, bool val, Error **errp)
     ESP32S31_MACHINE(obj)->asid = val;
 }
 
